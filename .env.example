# ─────────────────────────────────────────────────────────────
# Pritam Maji — Portfolio environment variables
# Copy this file to `.env.local` and fill in your values.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas). If empty, the app
# falls back to a local JSON file store (data/db.json) — perfect
# for local development.
MONGODB_URI=

# Admin dashboard credentials (Basic Auth via middleware).
ADMIN_USER=pritam
ADMIN_PASSWORD=change-me-strong-password

# Optional: 3D model for the hero. Drop a .glb/.gltf into /public/models
# and set this to "/models/your-model.glb" to replace the abstract
# hero core with your photo-based 3D model.
NEXT_PUBLIC_MODEL_URL=

# Optional: webhook that receives contact form submissions
# (e.g. a Zapier / Make / Discord webhook). POSTs the raw JSON.
CONTACT_WEBHOOK_URL=

# Canonical site URL (used for SEO meta + sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
