# ─────────────────────────────────────────────────────────────
# Pritam Maji — Portfolio Frontend environment variables
# Copy this file to `.env.local` and fill in your values.
# ─────────────────────────────────────────────────────────────

# Base URL of the Express API (backend/). Local dev default:
# http://localhost:5001 — point this at your Render/Railway URL in prod.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Optional: 3D model for the hero. Drop a .glb/.gltf into /public/models
# and set this to "/models/your-model.glb" to replace the abstract
# hero core with your photo-based 3D model.
NEXT_PUBLIC_MODEL_URL=

# Canonical site URL (used for SEO meta + sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
