# ─────────────────────────────────────────────────────────────
# Pritam Maji — Portfolio API (Express) environment variables
# Copy to `.env` before running.
# ─────────────────────────────────────────────────────────────

# Server port (5001 avoids macOS AirPlay Receiver which occupies 5000)
PORT=5001

# MongoDB connection string (Atlas or local). If empty, the API
# falls back to a local JSON file store (data/db.json).
MONGODB_URI=mongodb://localhost:27017

# Admin dashboard credentials + JWT signing secret.
ADMIN_USER=pritam
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins.
# "*" allows everything (fine for local dev, avoid in production).
CORS_ORIGIN=http://localhost:3000

# Optional: webhook that receives contact form submissions
# (e.g. a Zapier / Make / Discord webhook). POSTs the raw JSON.
CONTACT_WEBHOOK_URL=
